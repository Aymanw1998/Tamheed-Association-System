# =============================================================================
# Tamheed client environment
# Copy to apps/system/.env (or run "npm run setup" from the repo root).
#
# Nothing is required: the app calls /api on its own address. In development
# CRA proxies /api to the local server (see "proxy" in apps/system/package.json);
# in production the server serves the built client (SERVE_CLIENT=true).
# =============================================================================

# [OPTIONAL] dev server port. Default: 3000
# PORT=3000

# [OPTIONAL] The IT site's address, for the «قسم الIT» button (it opens it in a
# new tab, signed in with a one-time pass in the address fragment) and for the
# links of the account-locked / access-changed alerts. Default: this site's
# address with "it." in front (it.<domain>).
# REACT_APP_IT_URL=https://it.example.com
