# =============================================================================
# Tamheed server environment
# Copy to server/config/.env (or run "npm run setup" from the repo root) and
# fill in real values. Never commit the real .env: the repository is public.
#
#   [REQUIRED]  the server will not start or a core feature breaks without it
#   [OPTIONAL]  empty = the default written next to it is used
# =============================================================================


# ---- Server -----------------------------------------------------------------
# [OPTIONAL] default 5000
PORT=5000
# [REQUIRED] development | production
NODE_ENV=development
# [OPTIONAL] true = this server also serves the built client (client/build) on
# the same address, so no CORS is needed.
SERVE_CLIENT=false
# [OPTIONAL] extra cross-origin callers, comma separated.
# Empty = http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=
# [OPTIONAL] the web app's public address, used to build file share links.
# Empty = the address of the incoming request.
CLIENT_URL=http://localhost:3000


# ---- Database ---------------------------------------------------------------
# [REQUIRED] local: mongodb://127.0.0.1:27017/tamheed_db  ·  Atlas: mongodb+srv://...
MONGO_URI=mongodb://127.0.0.1:27017/tamheed_db
# [OPTIONAL] database name used by the models. Default: tamheed_db
DB_NAME=tamheed_db
# [OPTIONAL] DNS servers for mongodb+srv:// lookups, comma separated
# (fixes "querySrv ECONNREFUSED" on some networks). Example: 8.8.8.8,1.1.1.1
DNS_SERVERS=


# ---- Sign-in and security ---------------------------------------------------
# [REQUIRED] two different long random strings. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# [REQUIRED for the sport site] signs the student cookie. A third, different
# random string; without it student sign-in answers 500. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SPORT_SESSION_SECRET=
# [OPTIONAL] token lifetimes in seconds. Defaults: access 86400 (1 day),
# refresh 604800 (7 days).
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# [REQUIRED] exactly 64 hex characters - the server crashes on start without it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Do not change it after users exist: stored passwords depend on it.
PASSWORD_ENC_KEY_HEX=


# ---- System account (created automatically on server start) ----------------
# [REQUIRED] the system account's ID number and first password. It must
# choose a new password at its first sign-in, then every 30 days.
SYSTEM_ADMIN_TZ=
SYSTEM_ADMIN_PASSWORD=
# [REQUIRED for recovery] a real mailbox the owner reads. Temporary passwords
# and failed sign-in alerts for the system account go ONLY here. Put the real
# address in server/config/.env on the server, never in this file.
# The server warns at start while this is empty or ends with .local.
SYSTEM_ADMIN_EMAIL=system-admin@tamheed.local
# [OPTIONAL] profile details of the system account
SYSTEM_ADMIN_FIRSTNAME=System
SYSTEM_ADMIN_LASTNAME=Admin
SYSTEM_ADMIN_PHONE=
SYSTEM_ADMIN_CITY=
SYSTEM_ADMIN_STREET=
SYSTEM_ADMIN_GENDER=ذكر
SYSTEM_ADMIN_STORAGE_FOLDER=system-admin


# ---- Email (SMTP) -----------------------------------------------------------
# [REQUIRED for email] password reset codes, system-account recovery and
# alerts, and the nightly vehicle digest. Without it only in-app notices work.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# [REQUIRED for email] sender address. Email is treated as configured only
# when SMTP_SERVER, SMTP_PORT and SMTP_FROM are all set.
SMTP_FROM=


# ---- AI assistant and document reading (Anthropic) ---------------------------
# [OPTIONAL] master switch for every AI feature: the assistant's chat, data
# answers and proposed actions, and reading vehicle licences/policies.
# Anything but "true" = AI is hidden from the whole system (no chat tab, no
# "read document" button). Real-time alerts are not AI and always work.
AI_ENABLED=false
# [REQUIRED when AI_ENABLED=true] from https://console.anthropic.com -> API Keys.
ANTHROPIC_API_KEY=


# ---- Google Drive (all uploaded files and photos) ---------------------------
# [REQUIRED for files] from https://console.cloud.google.com: enable
# "Google Drive API" and create an OAuth 2.0 Client ID (Web application) with
# exactly this redirect URI. Then sign in as the system account and connect
# Drive from the Files page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/storage/google/callback
# [OPTIONAL] top folder created in Drive. Default: Tamheed
GOOGLE_DRIVE_ROOT_FOLDER=Tamheed


# ---- File storage (Files page) ----------------------------------------------
# [OPTIONAL] the storage backend this server talks to. Default: the built-in
# Google-Drive backend at /api/storage-backend on this same server.
CENTRAL_STORAGE_API_URL=http://127.0.0.1:5000/api/storage-backend
# [OPTIONAL] public address of this API, used to build file links.
# Checked in this order: TAMHEED_PUBLIC_API_URL, PUBLIC_API_URL, API_URI.
TAMHEED_PUBLIC_API_URL=
PUBLIC_API_URL=
API_URI=
# [OPTIONAL] advanced storage settings - leave empty for the defaults.
STORAGE_COLLECTION=root
STORAGE_METADATA_COLLECTION=Storage
CENTRAL_STORAGE_FILE_BASE_URL=
# path | query. Default: path
CENTRAL_STORAGE_FILE_ACCESS_MODE=
# Default: relativePath
CENTRAL_STORAGE_FILE_ACCESS_PARAM=
# [RECOMMENDED] secrets for signed file links and share links
# (default: JWT_ACCESS_SECRET). Use their own random strings in production.
STORAGE_SIGNED_URL_SECRET=
STORAGE_SHARE_LINK_SECRET=
# Link lifetimes. Defaults: 2m and 30d
STORAGE_SIGNED_URL_TTL=
STORAGE_SHARE_LINK_TTL=
# Upload limits. Defaults: 2048 MB per file, 60 MB per chunk, 2000 chunks
STORAGE_UPLOAD_MAX_MB=
STORAGE_CHUNK_MAX_MB=
STORAGE_MAX_UPLOAD_CHUNKS=
# Temporary upload folder and its cleanup. Defaults: ./storage-upload-sessions, 24 h
STORAGE_UPLOAD_SESSION_DIR=
STORAGE_UPLOAD_SESSION_TTL_HOURS=
