# Tamheed server env example
# Copy this file to ".env" in this same folder (server/config/.env) and fill in real values.
# Run "npm run setup" from the repo root to do this automatically.

PORT=5000
NODE_ENV=development

# ---- Database ----
# Entities/api.js talks directly to MongoDB via Mongoose (see server/config/db.js).
# For local dev, point this at a local mongod - e.g. one already running on this
# machine (MongoDB Compass shows it at mongodb://localhost:27017).
MONGO_URI=mongodb://127.0.0.1:27017/tamheed_db

# ---- Global server (shared AI backend + remote file storage) ----
# Tamheed must call GLOBAL-SERVER only. It must not call AI-SERVICE or OpenAI directly.
# On the SERVER PC, replace SERVER_PC_IP_OR_DOMAIN with the real IP/domain.
# NOTE: this is unrelated to MONGO_URI above - it's only used for the AI proxy
# (server/services/ai.service.js) and for remote file storage (Storage.controller.js),
# which have NOT been localized. Uploads/files won't work locally without this.
GLOBAL_SERVER_URL=http://SERVER_PC_IP_OR_DOMAIN:5000
API_URI=http://SERVER_PC_IP_OR_DOMAIN:5000
GLOBAL_DB_API_TOKEN=
GLOBAL_SERVICE_TOKEN=

# ---- CORS ----
# Comma-separated list of allowed origins. Leave empty to use the built-in defaults in server.js.
ALLOWED_ORIGINS=

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
# REQUIRED, exactly 64 hex characters (32 bytes) - the server crashes on boot without a valid value.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_ENC_KEY_HEX=

# ---- System admin bootstrap (created automatically on server start) ----
SYSTEM_ADMIN_TZ=
SYSTEM_ADMIN_FIRSTNAME=System
SYSTEM_ADMIN_LASTNAME=Admin
SYSTEM_ADMIN_EMAIL=system-admin@tamheed.local
SYSTEM_ADMIN_PHONE=
SYSTEM_ADMIN_CITY=
SYSTEM_ADMIN_STREET=
SYSTEM_ADMIN_GENDER=ذكر
SYSTEM_ADMIN_STORAGE_FOLDER=system-admin

# ---- Storage (files) ----
DB_NAME=tamheed_db
STORAGE_COLLECTION=
STORAGE_METADATA_COLLECTION=
CENTRAL_STORAGE_API_URL=
CENTRAL_STORAGE_FILE_BASE_URL=
CENTRAL_STORAGE_FILE_ACCESS_MODE=
CENTRAL_STORAGE_FILE_ACCESS_PARAM=
STORAGE_SIGNED_URL_SECRET=
STORAGE_SIGNED_URL_TTL=
STORAGE_SHARE_LINK_SECRET=
STORAGE_SHARE_LINK_TTL=
STORAGE_UPLOAD_MAX_MB=
STORAGE_CHUNK_MAX_MB=
STORAGE_MAX_UPLOAD_CHUNKS=
STORAGE_UPLOAD_SESSION_DIR=
STORAGE_UPLOAD_SESSION_TTL_HOURS=
FILE_STORAGE_ROOT=
FILE_PUBLIC_BASE_URL=
CLIENT_URL=http://localhost:3000
TAMHEED_PUBLIC_API_URL=
PUBLIC_API_URL=

# ---- Cloud storage providers (optional, only if used) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_ACCESS_KEY=
AWS_SECRET_ACCESS=

# ---- Google Drive (profile/student photos - see services/googleDrive.service.js) ----
# From https://console.cloud.google.com/: enable "Google Drive API", then create
# an OAuth 2.0 Client ID (type "Web application") with this exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/storage/google/callback
GOOGLE_DRIVE_ROOT_FOLDER=Tamheed
# After filling the two values above, start the server and open
# http://localhost:5000/api/storage/google/connect once to link a Drive account.

# ---- OnlyOffice (document preview/editing, optional) ----
ONLYOFFICE_JWT_SECRET=

# ---- Email (SMTP) ----
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
